// Copy this file to wifi_secrets.h (same folder) and fill in the network the
// RPi5 of the HIL bench is on (Pi 192.168.1.76, LOGGER_PC_IP in logger.h).
// wifi_secrets.h is in .gitignore: it never goes to GitHub.
// ESP32-S3 has 2.4 GHz WiFi only: a 5 GHz-only network will not connect.
#ifndef WIFI_SECRETS_H
#define WIFI_SECRETS_H

#define WIFI_SSID       "your-2.4GHz-SSID"
#define WIFI_PASSWORD   "your-password"

#endif
