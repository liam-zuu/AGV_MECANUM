.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# BNO08x library: generated docs and README images are not needed to build
components/esp32_BNO08x/docs/
components/esp32_BNO08x/README_images/

# Build id headers written by scripts/build_id.py at build time (every env; s06_load also the s06 one)
src/s06/build_id_gen.h
src/fw_id_gen.h

# pio device monitor log files (not firmware input; untracked files would make every build dirty=1)
logs/

# WiFi SSID/password, local only (src/wifi/wifi_secrets.h.example is the template)
src/wifi/wifi_secrets.h
